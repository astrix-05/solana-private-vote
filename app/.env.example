# Solana Network Configuration
# Options: https://api.devnet.solana.com (devnet) or https://api.mainnet-beta.solana.com (mainnet)
REACT_APP_SOLANA_RPC_URL=https://api.devnet.solana.com

# Backend Relayer API Configuration
# For local development: http://localhost:3001/api
# For production: https://your-backend-domain.com/api
REACT_APP_API_URL=http://localhost:3001/api

# API Key for backend authentication
# Get this from your backend configuration
REACT_APP_API_KEY=your_api_key_change_in_production_67890

# Program ID (optional - defaults to hardcoded value)
# REACT_APP_PROGRAM_ID=7ZXBjyqFJPNHj3nRdeJmu2JKSnph5BpJ9nwxTTMx7RwJ
